package tests;

import entities.Task;
import manager.HistoryManager;
import manager.InMemoryHistoryManager;
import org.junit.jupiter.api.Test;

import java.util.List;

import static org.junit.jupiter.api.Assertions.*;

public class InMemoryHistoryManagerTest {

    @Test
    public void checkIfDuplicateTasksAreNotAddedToHistory() {
        // Проверяем, что дубликаты задач не добавляются в историю
        HistoryManager historyManager = new InMemoryHistoryManager();
        Task task = new Task("Уборка", "Убрать квартиру");

        historyManager.add(task);
        historyManager.add(task); // Добавляем задачу дважды

        List<Task> historyTasks = historyManager.getHistory();
        assertEquals(1, historyTasks.size()); // Должна остаться только одна запись
        assertEquals(task, historyTasks.get(0));
    }

    @Test
    public void checkThatMultipleTasksAreSavedInHistoryInCorrectOrder() {
        // Проверяем, что несколько задач сохраняются в истории в правильном порядке
        HistoryManager historyManager = new InMemoryHistoryManager();
        Task task = new Task("Уборка", "Убрать квартиру");
        Task epic = new Task("Ремонт", "Отремонтировать квартиру");

        historyManager.add(task);
        historyManager.add(epic);

        List<Task> historyTasks = historyManager.getHistory();
        assertEquals(2, historyTasks.size());
        assertEquals(task, historyTasks.get(0)); // Первая задача должна быть первой в истории
        assertEquals(epic, historyTasks.get(1)); // Вторая задача должна быть второй
    }

    @Test
    public void checkRemovalOfTaskFromHistory() {
        // Проверяем, что задача удаляется из истории
        HistoryManager historyManager = new InMemoryHistoryManager();
        Task task = new Task("Уборка", "Убрать квартиру");

        historyManager.add(task);
        historyManager.remove(task.getId()); // Удаляем задачу по ID

        List<Task> historyTasks = historyManager.getHistory();
        assertEquals(0, historyTasks.size()); // История должна быть пустой после удаления
    }

    @Test
    public void checkOrderOfTasksInHistory() {
        // Проверяем порядок задач в истории после добавления нескольких задач
        HistoryManager historyManager = new InMemoryHistoryManager();
        Task task1 = new Task("Уборка", "Убрать квартиру");
        Task task2 = new Task("Ремонт", "Отремонтировать квартиру");
        Task task3 = new Task("Покупки", "Купить продукты");

        historyManager.add(task1);
        historyManager.add(task2);
        historyManager.add(task3);

        List<Task> historyTasks = historyManager.getHistory();
        assertEquals(3, historyTasks.size());
        assertEquals(task1, historyTasks.get(0)); // Первая задача должна быть первой
        assertEquals(task2, historyTasks.get(1)); // Вторая задача должна быть второй
        assertEquals(task3, historyTasks.get(2)); // Третья задача должна быть третьей
    }
}